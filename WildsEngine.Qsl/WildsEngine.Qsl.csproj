<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>

    <AssemblyName>WildsEngine.Qsl</AssemblyName>
    <RootNamespace>WildsEngine.Qsl</RootNamespace>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <PackageId>WildsEngine.Qsl</PackageId>
    <Title>Wilds Engine QSL Integration</Title>
    <Description>Integration between the Wilds simulation lifecycle and QSL stateful processing over consumer-owned objects and explicitly attached runtime state.</Description>
    <Authors>TethraSolutions, LLC</Authors>
    <Company>TethraSolutions, LLC</Company>
    <Copyright>Copyright Â© TethraSolutions, LLC. All rights reserved.</Copyright>

    <RepositoryUrl>https://github.com/5lsjeremy/WildsEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <Deterministic>true</Deterministic>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WildsEngine.Core\WildsEngine.Core.csproj" />
    <ProjectReference Include="..\WildsEngine.Discoveries\WildsEngine.Discoveries.csproj" />
    <ProjectReference Include="..\..\QSL\QSL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md"
          Pack="true"
          PackagePath="" />
  </ItemGroup>
</Project>


